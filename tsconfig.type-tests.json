{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@askrjs/askr",
    "paths": {
      "@askrjs/monaco": ["./src/index.ts"]
    }
  },
  "include": ["tests/**/*", "src/**/*.ts", "src/**/*.tsx", "types/**/*.d.ts"]
}
